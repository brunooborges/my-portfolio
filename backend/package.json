{
  "name": "portfolio-visitor-counter",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless unique-visitor counter for the portfolio: one Lambda (Function URL) and one DynamoDB table.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --minify --target=es2022 --format=esm --platform=node --external:@aws-sdk/* --out-extension:.js=.mjs --outdir=dist",
    "validate": "sam validate --lint"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1143.0",
    "@aws-sdk/lib-dynamodb": "^3.1143.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9",
    "vitest": "^4"
  }
}
